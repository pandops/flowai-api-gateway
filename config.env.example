# Supply credentials at runtime through your secret manager.
API_GATEWAY_BIND_HOST=0.0.0.0
API_GATEWAY_BIND_PORT=8080
API_GATEWAY_OIDC_ISSUER=https://identity.example.invalid
API_GATEWAY_OIDC_CLIENT_ID=flowai-gateway
API_GATEWAY_OIDC_REDIRECT_URI=https://flowai.example.invalid/auth/v1/callback
API_GATEWAY_OIDC_TEAM_CLAIM_ADAPTER=string_array
API_GATEWAY_OIDC_TEAM_CLAIM_POINTER=/groups
API_GATEWAY_OIDC_TEAM_CLAIM_SOURCE=id_token
API_GATEWAY_MEMBERSHIP_MAX_AGE=5m
API_GATEWAY_POSTGRES_URL='postgres://gateway@postgres.example.invalid/gateway?sslmode=verify-full&sslrootcert=/run/trust/postgres-ca.pem'
API_GATEWAY_MIGRATION_POSTGRES_URL='postgres://gateway_migrate@postgres.example.invalid/gateway?sslmode=verify-full&sslrootcert=/run/trust/postgres-ca.pem'
API_GATEWAY_SESSION_KEY_HEX=
API_GATEWAY_SESSION_TTL=1h
API_GATEWAY_WORKING_TOKEN_PRIVATE_KEY_BASE64=
API_GATEWAY_WORKING_TOKEN_KEY_ID=replace-with-key-id
API_GATEWAY_WORKING_TOKEN_ISSUER=https://flowai.example.invalid
API_GATEWAY_WORKING_TOKEN_AUDIENCE=flowai
API_GATEWAY_NATS_URL=tls://nats.example.invalid:4222
API_GATEWAY_NATS_CA_FILE=/run/trust/nats-ca.pem
API_GATEWAY_NATS_CREDENTIALS_FILE=/run/secrets/gateway-nats.creds
API_GATEWAY_JOURNAL_URL=https://journal.example.invalid
API_GATEWAY_JOURNAL_TOKEN=
API_GATEWAY_WEB_UI_URL=https://web-ui.example.invalid
