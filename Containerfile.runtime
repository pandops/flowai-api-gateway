FROM docker.io/library/golang:1.26.2-alpine@sha256:80fbb8f9b2fa541a7d34378f1ad10f4f1c433817c4ed39ddb3e2f3ec3e961271 AS trust

FROM scratch
COPY --from=trust /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chmod=0555 app /api-gateway
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/api-gateway"]
